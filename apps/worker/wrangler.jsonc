{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ezra-mcp-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-15",
	"workers_dev": true,
	"routes": [
		{
			"pattern": "ezramcp.com/*",
			"zone_name": "ezramcp.com"
		}
	],
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"EZRA_MCP_UPGRADE_URL": "https://ezramcp.com/pro/",
		"KLAVIYO_REVISION": "2026-04-15"
	},
	"assets": {
		"directory": "../site/dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/v1/*",
			"/health"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ezra-mcp-prod",
			"database_id": "13f487c0-02fc-44da-814c-252925bb59da",
			"migrations_dir": "migrations"
		}
	],
	"secrets": {
		"required": [
			"STRIPE_SECRET_KEY",
			"STRIPE_WEBHOOK_SECRET",
			"STRIPE_PRICE_EZRA_PRO_MONTHLY",
			"STRIPE_PRICE_EZRA_MAX_MONTHLY",
			"TOKEN_HASH_PEPPER"
		]
	}
}
