{
  "name": "ezra-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @ezra-mcp/worker dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "verify": "pnpm validate:docs && pnpm validate:plugin && pnpm secret:scan && pnpm build && pnpm lint && pnpm test",
    "validate:docs": "./scripts/validate-docs.sh",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "markdown:validate": "./scripts/validate-docs.sh",
    "plugin:validate": "node scripts/validate-plugin.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "prayer:panel:manifest": "node scripts/prayer-panel-runner.mjs manifest",
    "prayer:panel:pilot": "node scripts/prayer-panel-runner.mjs pilot --run-id pilot-2026-05-24",
    "prayer:panel:validate": "node scripts/prayer-panel-runner.mjs validate --run-dir baseline/prayer-dictionary/prayer-pass/runs/pilot-2026-05-24"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
